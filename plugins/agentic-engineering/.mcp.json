{
  "mcpServers": {
    "flux-operator-mcp": {
      "command": "sh",
      "args": [
        "-c",
        "[ -n \"$KUBECONFIG\" ] || { [ -n \"$HOME\" ] || { echo 'flux-operator-mcp: set KUBECONFIG or HOME' >&2; exit 1; }; KUBECONFIG=\"$HOME/.kube/config\"; }; export KUBECONFIG; exec flux-operator-mcp serve --read-only"
      ]
    },
    "github-ghas-tools": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "code_security,secret_protection,security_advisories,dependabot",
        "X-MCP-Readonly": "true"
      },
      "headersHelper": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/github-mcp-headers.sh\" \"${CLAUDE_PLUGIN_DATA}\""
    },
    "siderolabs-docs": {
      "type": "http",
      "url": "https://docs.siderolabs.com/mcp"
    },
    "svelte": {
      "type": "http",
      "url": "https://mcp.svelte.dev/mcp"
    }
  }
}
